{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionAtlas",
  "version": "0.1.0",
  "identifier": "com.sessionatlas.console",
  "build": {
    "beforeBuildCommand": "npm run prepare:release",
    "beforeDevCommand": "npm run prepare:sidecar",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SessionAtlas — AI CLI Project Workspace",
        "width": 1480,
        "height": 940,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#0e0d0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'nonce-{{nonce}}'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sessionatlas"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
