<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SessionAtlas.Desktop.ViewModels"
             x:Class="SessionAtlas.Desktop.Views.ProjectListView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">

  <ListBox x:Name="ProjectList"
           ItemsSource="{Binding Projects}"
           SelectedItem="{Binding SelectedProject}"
           Background="Transparent"
           BorderThickness="0">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="vm:ProjectItemViewModel">
        <Grid ColumnDefinitions="*,Auto" Margin="4,6">
          <StackPanel Grid.Column="0" Spacing="3">
            <!-- 项目名称 + 分支 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayName}"
                         FontWeight="Bold"
                         FontSize="14"
                         Foreground="#e0e0e0" />
              <TextBlock Text="{Binding GitBranch}"
                         FontSize="11"
                         Foreground="#f8c471"
                         IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- 路径 -->
            <TextBlock Text="{Binding Path}"
                       FontSize="11"
                       Foreground="#808080"
                       TextTrimming="CharacterEllipsis" />

            <!-- 工具图标 + 时间 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding ToolIcons}"
                         FontSize="13" />
              <TextBlock Text="{Binding ToolTags}"
                         FontSize="10"
                         Foreground="#4a9eff" />
              <TextBlock Text="{Binding LastAccessed}"
                         FontSize="10"
                         Foreground="#606060" />
            </StackPanel>
          </StackPanel>

          <!-- 右侧箭头 -->
          <TextBlock Grid.Column="1"
                     Text="▶"
                     FontSize="12"
                     Foreground="#4a9eff"
                     VerticalAlignment="Center"
                     Margin="8,0,0,0" />
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
