<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SessionAtlas.Desktop.ViewModels"
             xmlns:terminal="using:Iciclecreek.Terminal"
             x:Class="SessionAtlas.Desktop.Views.AgentSessionView"
             x:DataType="vm:AgentSessionViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <!-- 顶部信息栏 -->
    <Border Grid.Row="0" Background="#252526" Padding="12" CornerRadius="4" BorderBrush="#3a3a3a" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding ToolIcon}" FontSize="20" />
            <TextBlock Text="{Binding ToolName}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#e0e0e0" />
            <TextBlock Text="{Binding Status, StringFormat='状态: {0}'}"
                       FontSize="12"
                       Foreground="#f8c471" />
          </StackPanel>
          <TextBlock Text="{Binding ProjectPath}"
                     FontSize="12"
                     Foreground="#808080" />
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="12"
                     Foreground="#e74c3c"
                     IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="关闭会话"
                Command="{Binding CloseCommand}"
                Padding="12,6"
                Background="#c0392b"
                Foreground="White"
                VerticalAlignment="Top" />
      </Grid>
    </Border>

    <!-- 内嵌终端（PTY + XTerm 渲染） -->
    <terminal:TerminalControl x:Name="Terminal"
                              Grid.Row="1"
                              Margin="0,8"
                              FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                              FontSize="14"
                              BufferSize="5000"
                              Background="#0c0c0c"
                              Foreground="#e0e0e0"
                              ProcessExited="OnProcessExited" />

    <!-- 底部操作按钮 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <Button Content="📂 打开项目目录"
              Command="{Binding OpenDirectoryCommand}"
              Padding="12,6"
              Background="#3a3a3a"
              Foreground="White" />
    </StackPanel>
  </Grid>
</UserControl>
